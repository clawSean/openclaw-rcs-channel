{
  "name": "rcs",
  "version": "2026.10.15",
  "description": "Secure RCS Business Messaging for OpenClaw with text, media, durable webhooks, access control, multi-account routing, and delivery/read visibility.",
  "license": "MIT",
  "homepage": "https://github.com/clawSean/openclaw-rcs-channel#readme",
  "bugs": {
    "url": "https://github.com/clawSean/openclaw-rcs-channel/issues"
  },
  "keywords": [
    "openclaw",
    "rcs",
    "twilio",
    "business-messaging",
    "customer-messaging",
    "conversational-ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/clawSean/openclaw-rcs-channel"
  },
  "type": "module",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "openclaw": "2026.10.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "rcs",
      "configuredState": {
        "env": {
          "anyOf": [
            "TWILIO_ACCOUNT_SID",
            "TWILIO_AUTH_TOKEN",
            "TWILIO_RCS_MESSAGING_SERVICE_SID",
            "RCS_WEBHOOK_PATH",
            "RCS_PUBLIC_WEBHOOK_URL",
            "RCS_ALLOWED_USERS"
          ]
        }
      },
      "label": "RCS",
      "selectionLabel": "RCS Business Messaging (Twilio)",
      "detailLabel": "Twilio RCS Business Messaging",
      "docsPath": "/channels/rcs",
      "docsLabel": "rcs",
      "blurb": "Branded RCS customer conversations with text, media, durable webhooks, and delivery/read visibility.",
      "order": 89,
      "quickstartAllowFrom": true,
      "setup": {
        "fields": [
          {
            "key": "accountSid",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--account-sid <sid>",
              "description": "Twilio account SID"
            }
          },
          {
            "key": "authToken",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--auth-token <token>",
              "description": "Twilio auth token"
            }
          },
          {
            "key": "messagingServiceSid",
            "kind": "string",
            "cli": {
              "flags": "--messaging-service-sid <sid>",
              "description": "Twilio RCS Messaging Service SID"
            }
          },
          {
            "key": "webhookPath",
            "kind": "string",
            "cli": {
              "flags": "--webhook-path <path>",
              "description": "RCS webhook path"
            }
          },
          {
            "key": "publicWebhookUrl",
            "kind": "string",
            "cli": {
              "flags": "--public-webhook-url <url>",
              "description": "Public RCS webhook URL"
            }
          },
          {
            "key": "dmPolicy",
            "kind": "choice",
            "choices": ["pairing", "allowlist", "open", "disabled"],
            "cli": {
              "flags": "--dm-policy <policy>",
              "description": "RCS DM policy"
            }
          },
          {
            "key": "allowFrom",
            "kind": "string-list",
            "cli": {
              "flags": "--allow-from <numbers>",
              "description": "Allowed RCS senders"
            }
          }
        ]
      }
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.10.3",
      "pluginSdkVersion": "2026.10.3",
      "bundledDist": false
    },
    "install": {
      "clawhubSpec": "clawhub:clawSean/rcs",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.1",
      "allowInvalidConfigRecovery": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  }
}
